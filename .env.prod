################################################################################
# LLM - Azure OpenAI
################################################################################
LLM_PROVIDER="azure"
LLM_MODEL="azure/arya-local-4o"
LLM_ENDPOINT="https://arya-local.openai.azure.com"
LLM_API_KEY="<YOUR_AZURE_API_KEY>"
LLM_API_VERSION="2024-12-01-preview"
LLM_INSTRUCTOR_MODE="json_schema_mode"

################################################################################
# Embeddings - Azure OpenAI
################################################################################
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="azure/text-embedding-3-large"
EMBEDDING_ENDPOINT="https://arya-local.openai.azure.com/openai/deployments/arya-local-embedding-3-large"
EMBEDDING_API_KEY="<YOUR_AZURE_API_KEY>"
EMBEDDING_API_VERSION="2024-12-01-preview"
EMBEDDING_DIMENSIONS=3072
EMBEDDING_MAX_TOKENS=8191
EMBEDDING_BATCH_SIZE=64

################################################################################
# Graph Database - Neo4j (client-server, concurrency-safe)
################################################################################
GRAPH_DATABASE_PROVIDER="neo4j"
GRAPH_DATABASE_URL="bolt://neo4j:7687"
GRAPH_DATABASE_NAME="neo4j"
GRAPH_DATABASE_USERNAME="neo4j"
GRAPH_DATABASE_PASSWORD="cognee_graph_2024"

################################################################################
# Vector Database - PGVector (reuses Postgres)
################################################################################
VECTOR_DB_PROVIDER="pgvector"
VECTOR_DB_URL="postgresql://cognee:cognee@postgres:5432/cognee_db"
VECTOR_DB_HOST="postgres"
VECTOR_DB_PORT=5432
VECTOR_DB_USERNAME="cognee"
VECTOR_DB_PASSWORD="cognee"
VECTOR_DATASET_DATABASE_HANDLER="pgvector"

################################################################################
# Relational Database - PostgreSQL
################################################################################
DB_PROVIDER="postgres"
DB_HOST="postgres"
DB_PORT=5432
DB_NAME="cognee_db"
DB_USERNAME="cognee"
DB_PASSWORD="cognee"

################################################################################
# Pipeline Queue - ARQ (Redis-backed async worker)
################################################################################
PIPELINE_QUEUE_BACKEND="arq"
PIPELINE_QUEUE_REDIS_HOST="redis"
PIPELINE_QUEUE_REDIS_PORT=6379
PIPELINE_QUEUE_REDIS_DB=1

################################################################################
# Access Control
################################################################################
ENABLE_BACKEND_ACCESS_CONTROL=True
REQUIRE_AUTHENTICATION=True

################################################################################
# LLM Rate Limiting
################################################################################
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_REQUESTS=60
LLM_RATE_LIMIT_INTERVAL=60

################################################################################
# Security / CORS
################################################################################
CORS_ALLOWED_ORIGINS="https://your-domain.com"

################################################################################
# Retrieval
################################################################################
VECTOR_SEARCH_TOP_K=10

################################################################################
# Production Settings
################################################################################
ENV="prod"
TOKENIZERS_PARALLELISM="false"
LITELLM_LOG="ERROR"
TELEMETRY_DISABLED=0
